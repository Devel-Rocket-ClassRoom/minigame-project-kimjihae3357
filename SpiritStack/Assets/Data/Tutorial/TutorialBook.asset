  m_Script: {fileID: 11500000, guid: 5df12503d52286d49b99a3ea271559b6, type: 3}
  m_Name: TutorialBook
  m_EditorClassIdentifier: Assembly-CSharp::TutorialBook
  pages:
  - title: "1. \uCE74\uB4DC\uB97C \uB4DC\uB798\uADF8\uD558\uC5EC \uC2A4\uD0DD\uD558\uAE30"
    info: "\uCE74\uB4DC\uB97C \uB4DC\uB798\uADF8\uD574\uC11C \uB2E4\uB978 \uCE74\uB4DC\uC5D0
      \n\uB193\uC73C\uBA74 \uC790\uB3D9\uC73C\uB85C \uCE74\uB4DC\uAC00 \uC2A4\uD0DD\uB429\uB2C8\uB2E4."
    tip: "\uC8FC\uBBFC \uCE74\uB4DC\uB97C \uCC44\uC9D1\uBB3C \uCE74\uB4DC\uC5D0 \uC2A4\uD0DD\uD558\uBA74\n\uC790\uC6D0\uC744
      \uCC44\uC9D1\uD560 \uC218 \uC788\uC5B4\uC694"
  - title: "2. \uCE74\uB4DC \uC870\uD569\uD558\uAE30"
    info: "\uD544\uC694\uD55C \uC7AC\uB8CC \uCE74\uB4DC\uB97C \uD55C \uC2A4\uD0DD\uC73C\uB85C
      \uBAA8\uC73C\uBA74 \uC81C\uC791\uC774 \uC2DC\uC791\uB3FC\uC694. \uB808\uC2DC\uD53C\uAC00
      \uC644\uC131\uB418\uBA74 \uC9D1, \uC791\uC5C5\uC7A5, \uAD11\uC0B0 \uAC19\uC740
      \uC0C8\uB85C\uC6B4 \uCE74\uB4DC\uAC00 \uB9CC\uB4E4\uC5B4\uC9D1\uB2C8\uB2E4."
    tip: "\uB808\uC2DC\uD53C \uCC3D\uC5D0\uC11C \uD544\uC694\uD55C \uC870\uD569\uC744
      \uD655\uC778\uD558\uC138\uC694."
  - title: "3. \uC0C1\uC810 \uC774\uC6A9\uD558\uAE30"
    info: "\uCE74\uB4DC\uB97C \uD310\uB9E4\uD574\uC11C \uB3C8\uC744 \uBC8C\uACE0
      \uCE74\uB4DC\uD329\uC744 \uAD6C\uB9E4\uD558\uC138\uC694."
    tip: 
  - title: "4. \uD558\uB8E8 \uB9C8\uBB34\uB9AC\uD558\uAE30"
    info: "1\uBD84 \uD0C0\uC774\uBA38\uAC00 \uB05D\uB098\uBA74 \uC2DD\uB7C9 \uBC30\uBD84
      \uC2DC\uAC04\uC774 \uC2DC\uC791\uB3FC\uC694. \uC74C\uC2DD \uCE74\uB4DC\uB97C
      \uC120\uD0DD\uD574 \uC8FC\uBBFC\uC5D0\uAC8C \uBA39\uC774\uC138\uC694. \uC74C\uC2DD\uC774
      \uBD80\uC871\uD558\uBA74 \uC8FC\uBBFC\uC774 \uC0AC\uB9DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    tip: 
  - title: "5. \uB0A0\uC528\uC640 \uC801\uC5D0 \uB300\uBE44\uD558\uAE30"
    info: "\uBA70\uCE60\uB9C8\uB2E4 \uB0A0\uC528 \uB8F0\uB81B\uACFC \uC801 \uD3EC\uD0C8\uC774
      \uB4F1\uC7A5\uD574\uC694. \uB0A0\uC528\uB294 \uCC44\uC9D1, \uCE74\uB4DC \uC0C1\uD0DC\uC5D0
      \uC601\uD5A5\uC744 \uC8FC\uACE0 \uC801\uC740 \uC8FC\uBBFC\uC744 \uCD94\uC801\uD574
      \uC804\uD22C\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    tip: "\uC801\uC5D0 \uB300\uBE44\uD558\uAE30 \uC704\uD574 \uC8FC\uBBFC \uCE74\uB4DC\uB97C
      \uB9CE\uC774 \uBAA8\uC73C\uC138\uC694!"
